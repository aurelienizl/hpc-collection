# =========================================================
# 1. REAL-TIME PREEMPTION
# =========================================================
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# =========================================================
# 2. CPU ISOLATION (Dedicated Core 3/CPU 2)
# =========================================================
# Stop scheduler ticks on the isolated core
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_COMMON=y
CONFIG_CONTEXT_TRACKING_USER=y
# Offload RCU callbacks
CONFIG_RCU_NOCB_CPU=y

# Power Management (Disabled for consistency)
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# =========================================================
# 3. STRIPPED FEATURES (No Docker, No Virtualization)
# =========================================================
# Disable Container features to reduce scheduler overhead
CONFIG_NAMESPACES=n
CONFIG_CGROUPS=n
CONFIG_MEMCG=n
CONFIG_UTS_NS=n
CONFIG_IPC_NS=n
CONFIG_USER_NS=n
CONFIG_PID_NS=n
CONFIG_NET_NS=n

# Disable Virtual Networking (used by Docker bridges)
CONFIG_VETH=n
CONFIG_BRIDGE=n

# Disable OverlayFS (used by Docker images)
CONFIG_OVERLAY_FS=n

# =========================================================
# 4. HARDWARE STRIPPING (No USB / WiFi)
# =========================================================
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BLUETOOTH=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n