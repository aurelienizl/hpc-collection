# --- Real-Time Core ---
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# --- CPU Isolation ---
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_COMMON=y
CONFIG_CONTEXT_TRACKING_USER=y
CONFIG_RCU_NOCB_CPU=y

# --- Power & Performance ---
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_IDLE=n

# --- Stripped Subsystems ---
CONFIG_NAMESPACES=n
CONFIG_CGROUPS=n
CONFIG_MEMCG=n
CONFIG_UTS_NS=n
CONFIG_IPC_NS=n
CONFIG_USER_NS=n
CONFIG_PID_NS=n
CONFIG_NET_NS=n
CONFIG_VETH=n
CONFIG_BRIDGE=n
CONFIG_OVERLAY_FS=n

# --- Hardware Stripping ---
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BLUETOOTH=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n

# --- Research/Validation Tools ---
CONFIG_SCHED_DEBUG=y
CONFIG_FTRACE=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_HWLAT_TRACER=y

# --- Memory Determinism ---
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=n